---
import PlanCard from "./PlanCard.astro";

const landingPlans = [
    {
        name: "Landing Básica",
        descriptor: "Ideal para presentar tu negocio.",
        price: "$2,999",
        popular: false,
        quote: "Landing Básica",
        features: [
            "1 página (hasta 5 secciones)",
            "Diseño personalizado",
            "Optimización móvil",
            "Formulario de contacto",
            "SEO básico",
        ],
    },
    {
        name: "Landing Premium",
        descriptor: "Para campañas y presencia completa.",
        price: "$6,000",
        popular: true,
        quote: "Landing Premium",
        features: [
            "Hasta 3 páginas",
            "Diseño personalizado premium",
            "Optimización móvil",
            "Integración con redes sociales",
            "SEO avanzado",
            "Estadísticas básicas",
        ],
    },
    {
        name: "Landing a la Medida",
        descriptor: "Cuando el proyecto no cabe en un plan.",
        price: "Cotización",
        popular: false,
        quote: "Landing a la Medida",
        features: [
            "Páginas y secciones sin límite",
            "Animaciones y 3D a la medida",
            "Blog o gestor de contenido",
            "Integraciones (CRM, agenda, pagos)",
            "Acompañamiento después del lanzamiento",
        ],
    },
];

const ecommercePlans = [
    {
        name: "Tienda Básica",
        descriptor: "Empieza a vender en línea.",
        price: "$7,000",
        popular: false,
        quote: "Tienda Básica",
        features: [
            "Hasta 20 productos",
            "Diseño personalizado",
            "Carrito de compras",
            "1 método de pago",
            "Panel de administración",
        ],
    },
    {
        name: "Tienda Premium",
        descriptor: "Tienda completa, sin límites.",
        price: "$12,000",
        popular: true,
        quote: "Tienda Premium",
        features: [
            "Productos ilimitados",
            "Diseño personalizado premium",
            "Carrito avanzado",
            "Múltiples métodos de pago",
            "Panel de administración avanzado",
            "Integración con redes sociales",
            "SEO avanzado",
            "Estadísticas detalladas",
        ],
    },
    {
        name: "Tienda a la Medida",
        descriptor: "Para operaciones con reglas propias.",
        price: "Cotización",
        popular: false,
        quote: "Tienda a la Medida",
        features: [
            "Catálogo con variantes complejas",
            "Envíos, facturación e inventario conectados",
            "Cuentas de cliente y pedidos recurrentes",
            "Integración con tu ERP o punto de venta",
            "Soporte y mejoras continuas",
        ],
    },
];
---

<section
    id="plans"
    aria-labelledby="plans-title"
    class="w-full max-w-6xl mx-auto px-6 md:px-4 py-30"
>
    <!-- Título gigante al fondo: las tarjetas lo tapan a la mitad -->
    <div class="relative">
        <h2
            id="plans-title"
            data-split
            class="pointer-events-none absolute inset-x-0 top-0 select-none text-center text-[clamp(4.5rem,15vw,11rem)] font-semibold leading-[0.85] tracking-tight text-white"
        >
            Precios
        </h2>

        <!-- Luces que se difuminan a través del vidrio de las tarjetas -->
        <div aria-hidden="true" class="pointer-events-none absolute inset-0">
            <div
                class="absolute left-[18%] top-[18%] h-64 w-64 rounded-full bg-[#00FFC4]/15 blur-[90px]"
            >
            </div>
            <div
                class="absolute right-[14%] top-[30%] h-72 w-72 rounded-full bg-white/[0.07] blur-[100px]"
            >
            </div>
        </div>

        <!-- El relleno superior deja la mitad inferior del título detrás del vidrio -->
        <div
            id="landing-plans"
            class="relative z-10 mx-auto max-w-6xl pt-[clamp(3.5rem,7.5vw,5.75rem)]"
        >
            <div class="grid grid-cols-1 items-stretch gap-5 md:grid-cols-3">
                {landingPlans.map((plan) => <PlanCard {...plan} />)}
            </div>
        </div>

        <div
            id="ecommerce-plans"
            class="relative z-10 mx-auto hidden max-w-6xl pt-[clamp(3.5rem,7.5vw,5.75rem)]"
        >
            <div class="grid grid-cols-1 items-stretch gap-5 md:grid-cols-3">
                {ecommercePlans.map((plan) => <PlanCard {...plan} />)}
            </div>
        </div>
    </div>

    <!-- Control segmentado: debajo de las tarjetas, como en la referencia -->
    <div class="relative z-10 mt-10 flex flex-col items-center gap-3">
        <div
            class="inline-flex rounded-full border border-white/10 bg-white/[0.04] p-1 backdrop-blur-xl"
            role="group"
            aria-label="Tipo de plan"
        >
            <button
                type="button"
                data-plan="landing"
                aria-pressed="true"
                onclick="window.setPlanType('landing')"
                class="seg active rounded-full px-6 py-2 text-sm font-medium transition-colors"
            >
                Landing Page
            </button>
            <button
                type="button"
                data-plan="ecommerce"
                aria-pressed="false"
                onclick="window.setPlanType('ecommerce')"
                class="seg rounded-full px-6 py-2 text-sm font-medium transition-colors"
            >
                E-commerce
            </button>
        </div>

        <p class="text-sm text-[#8A8A94]">
            Todos incluyen diseño a la medida y cotización gratis.
        </p>
    </div>
</section>

<script is:inline>
    window.setPlanType = (type) => {
        const isLanding = type === "landing";
        const landing = document.getElementById("landing-plans");
        const ecommerce = document.getElementById("ecommerce-plans");
        const show = isLanding ? landing : ecommerce;
        const hide = isLanding ? ecommerce : landing;

        hide?.classList.add("hidden");
        if (show) {
            show.classList.remove("hidden", "plan-in");
            void show.offsetWidth; // reflow para reiniciar la animación
            show.classList.add("plan-in");
        }

        document.querySelectorAll(".seg").forEach((btn) => {
            const active = btn.dataset.plan === type;
            btn.classList.toggle("active", active);
            btn.setAttribute("aria-pressed", String(active));
        });
    };

    // Prefija el asunto del formulario al elegir un plan (lo usa también Servicios)
    window.selectPlan = (name) => {
        const subject = document.getElementById("subject");
        if (subject) subject.value = "Cotización: " + name;
    };

    document.addEventListener("DOMContentLoaded", () =>
        window.setPlanType("landing"),
    );
</script>

<style>
    .seg {
        color: #9a9aa4;
        cursor: pointer;
    }
    .seg.active {
        background-color: #00ffc4;
        color: #0d0f19;
    }

    /* Transición al cambiar entre Landing / E-commerce */
    @keyframes planFade {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .plan-in {
        animation: planFade 0.35s ease-out;
    }
    @media (prefers-reduced-motion: reduce) {
        .plan-in {
            animation: none;
        }
    }
</style>
