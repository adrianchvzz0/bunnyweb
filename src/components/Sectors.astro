---
// Puerta de entrada por rubro: el cliente se reconoce y llega a su página.
const sectors = [
    {
        href: "/clinicas",
        title: "Clínicas y consultorios",
        text: "Agenda en línea, tratamientos y confianza desde el primer clic.",
        img: "/images/proyecto5.webp",
        alt: "Demo de sitio para clínica médica",
    },
    {
        href: "/opticas",
        title: "Ópticas",
        text: "Catálogo de armazones con pedido directo por WhatsApp.",
        img: "/images/proyecto6.webp",
        alt: "Demo de sitio para óptica con catálogo",
    },
];
---

<section
    data-theme-section="light"
    id="rubros"
    aria-labelledby="rubros-title"
    class="w-full max-w-5xl mx-auto px-6 md:px-4 pb-22 md:pb-30"
>
    <div class="text-center">
        <h2 id="rubros-title" data-split class="text-5xl font-semibold text-white">
            ¿Qué negocio tienes?
        </h2>
        <p class="mt-3 text-xl text-[#9A9AA4]">
            Ya tenemos un sitio de muestra para el tuyo. <span class="text-[#00FFC4]">Míralo con tu nombre.</span>
        </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2">
        {
            sectors.map((s) => (
                <a
                    data-reveal
                    href={s.href}
                    class="keep-dark group relative block overflow-hidden rounded-3xl border border-white/10 transition-all duration-300 hover:border-[#00FFC4]/50 hover:shadow-[0_0_40px_-8px_rgba(0,255,196,0.35)]"
                >
                    <img
                        src={s.img}
                        alt={s.alt}
                        loading="lazy"
                        class="aspect-[16/9] w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.04]"
                    />
                    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#0d0f19] via-[#0d0f19]/40 to-transparent" />
                    <div class="absolute inset-x-0 bottom-0 p-6">
                        <h3 class="text-2xl font-bold text-white">{s.title}</h3>
                        <p class="mt-1 text-sm text-[#D0D0D4]">{s.text}</p>
                        <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-[#00FFC4]">
                            Ver cómo se vería la tuya
                            <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
                        </span>
                    </div>
                </a>
            ))
        }
    </div>
</section>
