<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>BunnyWeb — Pitch Deck</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@100..900&display=swap">
<style is:global>
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:#07080D;overflow:hidden}
#stage{position:fixed;left:50%;top:50%;width:1920px;height:1080px;transform-origin:center center}
#stage>section{position:absolute;inset:0;width:1920px;height:1080px;opacity:0;visibility:hidden;transition:opacity .45s ease,visibility .45s}
#stage>section.active{opacity:1;visibility:visible}
#stage>section:not(.active) .rise,#stage>section:not(.active) .mosaic{animation:none}
.ui{position:fixed;bottom:18px;right:22px;display:flex;gap:8px;align-items:center;font:14px Onest,Arial,sans-serif;color:#AEB7C7;z-index:10;opacity:.75}
.ui button{background:rgba(244,247,251,.08);border:1px solid rgba(244,247,251,.15);color:#F4F7FB;border-radius:10px;width:38px;height:34px;cursor:pointer;font-size:16px}
.ui button:hover{background:rgba(0,255,196,.18)}
@media print{html,body{overflow:visible;height:auto;background:none}.ui{display:none}#stage{position:static;transform:none!important;width:auto;height:auto}#stage>section{position:relative;opacity:1;visibility:visible;page-break-after:always}#stage .rise,#stage .mosaic{animation:none}@page{size:1920px 1080px;margin:0}}
/* deck styles */
section{padding:128px;font-family:'Onest',Arial,sans-serif;color:#F4F7FB;box-sizing:border-box;overflow:hidden}
.dark{background:radial-gradient(80% 70% at 80% 105%,#0F5A4E 0%,rgba(13,15,25,0) 62%),linear-gradient(172deg,#161B2B 0%,#0D0F19 48%,#0A0C14 100%)}
.light{background:linear-gradient(180deg,#F8F9FB 0%,#E9EBEF 100%);color:#12141C}
.mintbg{background:radial-gradient(70% 80% at 90% 100%,#00D9A8 0%,#00FFC4 60%);color:#0D0F19}
.pad-foot{padding:128px 128px 160px}
h1,h2,h3{font-family:'Onest',Arial,sans-serif;margin:0;letter-spacing:-0.02em}
h1{font-size:120px;line-height:1.0;font-weight:300;letter-spacing:-0.03em}
h2{font-size:72px;line-height:1.05;font-weight:400}
h3{font-size:32px;line-height:1.15;font-weight:500}
p{margin:0;font-size:24px;line-height:1.45}
.lead{font-family:'Onest',Arial,sans-serif;font-size:32px;line-height:1.3;color:#AEB7C7}
.mono-s{font-size:24px;line-height:1.45;color:#AEB7C7}
.light .mono-s{color:#454B59}
.mint{color:#00FFC4}
.light .mint{color:#068A6E}
.mono-s.mint{color:#00FFC4}
.light .mono-s.mint{color:#068A6E}
.brand{font-family:'Onest',Arial,sans-serif;font-size:32px;font-weight:600;letter-spacing:-0.01em}
.stack{height:824px;display:flex;flex-direction:column;justify-content:space-between}
.row{display:flex;justify-content:space-between;align-items:center;width:1664px}
.tag{display:flex;gap:8px;align-items:center}
.tag .lbl{font-size:24px;padding:4px 16px;border:2px solid rgba(244,247,251,0.35);border-radius:10px;color:#C9D1DD}
.tag .num{font-size:24px;padding:4px 12px;border-radius:10px;background:#F4F7FB;color:#0D0F19;font-weight:600}
.light .tag .lbl{border-color:rgba(18,20,28,0.3);color:#454B59}
.light .tag .num{background:#12141C;color:#F4F7FB}
.feat h3{margin-bottom:12px}
.cards{display:flex;gap:28px;margin-top:72px;width:1300px}
.card{flex:1;height:440px;border-radius:22px;padding:40px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;box-sizing:border-box}
.c-grad{background:linear-gradient(165deg,#1E7A69 0%,#0F3634 50%,#0D0F19 100%);color:#F4F7FB}
.c-ink{background:#0D0F19;color:#F4F7FB}
.c-white{background:#FBFBFC;color:#12141C;border:2px solid rgba(13,15,25,0.08)}
.c-grad .mono-s,.c-ink .mono-s{color:#BFC8D6}
.ico{width:64px;height:64px;border-radius:14px;background:rgba(244,247,251,0.12);display:flex;align-items:center;justify-content:center;color:#00FFC4}
.ico-l{background:#0D0F19;color:#00FFC4}
.ch{font-size:44px;line-height:1.08;font-weight:400;margin-bottom:16px}
.split{display:flex;gap:96px;height:824px}
.col-l{width:700px;display:flex;flex-direction:column;justify-content:space-between}
.col-r{flex:1;display:flex;flex-direction:column;gap:20px;justify-content:center}
.step{background:rgba(244,247,251,0.06);border:2px solid rgba(244,247,251,0.1);border-radius:18px;padding:30px 40px}
.step-top{display:flex;justify-content:space-between;margin-bottom:16px}
.step h3{margin-bottom:8px}
.bento{display:grid;grid-template-columns:420px 640px 1fr;grid-template-rows:1fr 1fr;gap:24px;height:824px;width:1664px}
.b{border-radius:22px;padding:40px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden;box-sizing:border-box}
.b-white{background:#FBFBFC;border:2px solid rgba(13,15,25,0.06)}
.b-dark{background:linear-gradient(170deg,#161B2B 0%,#0D0F19 60%,#0A2E2A 100%)}
.b-grad{background:linear-gradient(160deg,#1E7A69 0%,#0F3634 55%,#0D0F19 100%)}
.b-dark .tag .lbl{border-color:rgba(244,247,251,0.35);color:#C9D1DD}
.b-dark .tag .num{background:#F4F7FB;color:#0D0F19}
.b-grad .mono-s.mint{color:#00FFC4}
.stat{font-family:'Onest',Arial,sans-serif;font-size:120px;line-height:1;letter-spacing:-0.03em;color:#12141C}
.ch2{font-size:44px;line-height:1.08;font-weight:400;color:#12141C}
.plans{display:flex;gap:28px;margin-top:56px;width:1664px}
.plan{flex:1;border-radius:22px;padding:40px 44px;background:rgba(244,247,251,0.05);border:2px solid rgba(244,247,251,0.12)}
.plan-f{background:rgba(0,255,196,0.07);border-color:#00FFC4}
.plan-top{display:flex;justify-content:space-between;align-items:center;height:44px}
.badge{font-size:24px;padding:2px 14px;border-radius:999px;background:#00FFC4;color:#0D0F19;font-weight:600}
.price{font-family:'Onest',Arial,sans-serif;font-size:72px;line-height:1.1;margin-top:12px;letter-spacing:-0.02em}
.rule{border:none;border-top:2px solid rgba(244,247,251,0.12);margin:24px 0}
.item{color:#C9D1DD;margin-bottom:8px}
.foot{position:absolute;left:128px;bottom:64px;width:1664px}
.contacts{display:flex;gap:28px;width:1200px}
.contact{flex:1;border-top:2px solid rgba(244,247,251,0.2);padding-top:20px}
.contact h3{margin-top:8px}
@keyframes rise{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}
@keyframes fadein{from{opacity:0}to{opacity:1}}
.rise{animation:rise .7s cubic-bezier(.2,.7,.2,1) both}
.mosaic{animation:fadein 1.2s ease both}
.d1{animation-delay:.12s}.d2{animation-delay:.24s}.d3{animation-delay:.36s}.d4{animation-delay:.48s}.d5{animation-delay:.6s}

/* ---- responsive / mobile ---- */
/* botones de navegación más grandes y cómodos en pantallas táctiles */
@media (pointer:coarse){
  .ui{bottom:max(18px,env(safe-area-inset-bottom));right:max(14px,env(safe-area-inset-right));gap:10px;opacity:.9}
  .ui button{width:48px;height:44px;font-size:20px}
}
/* aviso para girar el teléfono cuando se presenta en vertical */
#rotate-hint{display:none}
@media (orientation:portrait) and (max-width:820px){
  #stage,.ui{display:none!important}
  #rotate-hint{
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px;
    position:fixed;inset:0;padding:32px;text-align:center;z-index:20;
    background:radial-gradient(80% 70% at 80% 105%,#0F5A4E 0%,rgba(13,15,25,0) 62%),linear-gradient(172deg,#161B2B 0%,#0D0F19 48%,#0A0C14 100%);
    color:#F4F7FB;font-family:'Onest',Arial,sans-serif;
  }
  #rotate-hint .phone{width:70px;height:120px;border:3px solid #00FFC4;border-radius:16px;animation:rotatePhone 2.2s ease-in-out infinite}
  #rotate-hint h3{font-size:26px;font-weight:500;margin:0}
  #rotate-hint p{font-size:17px;line-height:1.4;color:#AEB7C7;max-width:320px}
}
@keyframes rotatePhone{0%,30%{transform:rotate(0)}60%,100%{transform:rotate(-90deg)}}

</style></head><body>
<div id="rotate-hint"><div class="phone"></div><h3>Gira tu teléfono</h3><p>Este deck se presenta en horizontal. Rota tu dispositivo para verlo a pantalla completa.</p></div>
<div id="stage">
<section id="cover" class="dark" data-transition="fade">
